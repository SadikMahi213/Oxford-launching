# Docker Compose environment overrides.
# Copy this file to infra/.env and fill in production values.
# Never commit the real .env file with secrets.

# PostgreSQL
POSTGRES_DB=gaming_platform
POSTGRES_USER=gaming
POSTGRES_PASSWORD=REPLACE_ME

# Redis (no auth by default in dev; set a password for production)
# REDIS_PASSWORD=REPLACE_ME

# Backend API URL (used by frontend container)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
