# Root .gitignore for the Gaming Platform monorepo.
# This prevents .env files, IDE configs, and build artifacts from being committed.

# Environment files (secrets must NEVER be committed)
.env
.env.*
!.env.example

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Node
node_modules/
.next/
out/

# PHP
vendor/
composer.lock
.phpunit.cache/
.phpunit.result.cache

# Build artifacts
/public/build/
/public/hot
/public/storage
/storage/*.key
/storage/pail

# Docker
docker-compose.override.yml
