# ─────────────────────────────────────────────────────
# ArbiGrow — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/arbigrow

# ── Authentication ────────────────────────────────────
SECRET_KEY=change-this-to-a-random-64-char-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ──────────────────────────────────────────────
ALLOWED_ORIGINS=["https://yourdomain.com","http://yourdomain.com"]

# ── Application ──────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO
FRONTEND_DOMAIN=https://yourdomain.com
DB_SSL_REQUIRED=false

# ── Connection Pool ──────────────────────────────────
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# ── Email (SMTP) ─────────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@oxfordfinancialads.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=Oxford Financial Ads
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# ── Backblaze B2 (File Storage) ─────────────────────
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=Oxford-ads

# ── Auto ROI ─────────────────────────────────────────
AUTO_ROI_ENABLED=true
AUTO_ROI_POLL_SECONDS=21600

# ── Redis ────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Session ──────────────────────────────────────────
SESSION_TIMEOUT_MINUTES=60
REMEMBER_ME_DAYS=30

# ── Google Analytics ─────────────────────────────────
GOOGLE_ANALYTICS_CREDENTIALS=
GOOGLE_ANALYTICS_PROPERTY_ID=

# ── Security ─────────────────────────────────────────
MAX_FAILED_ATTEMPTS=5
SECURITY_LOG_ENABLED=true

# ── Frontend Build (passed at build time) ────────────
VITE_BACKEND_URL=http://backend:8000

# ── Docker ───────────────────────────────────────────
POSTGRES_PASSWORD=postgres
